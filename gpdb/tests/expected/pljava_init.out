-- The examples jar path depends on where WarehousePG is installed.
-- start_matchsubs
-- m/'file:\S*\/pljava-examples-[0-9.]+\.jar'/
-- s/'file:\S*\/pljava-examples-[0-9.]+\.jar'/'file:INSTALLDIR\/pljava-examples-VERSION.jar'/
-- end_matchsubs
-- PL/Java's load banner (versions NOTICE, JEP 411 advisory on Java 12+) depends
-- on the runtime JDK; keep this test's output independent of it.
set client_min_messages = error;
-- Non-extension installation: in 1.6 a plain LOAD of the library performs the
-- same groundwork CREATE EXTENSION does (sqlj schema, handlers, languages).
LOAD 'libpljava-so-1.6.10';
SELECT sqlj.install_jar('file:/usr/local/whpg/Versions/2.1.0/share/postgresql/pljava/pljava-examples-1.6.10.jar', 'examples', false);
 install_jar 
-------------
 
(1 row)

CREATE SCHEMA javatest AUTHORIZATION pljava_test;
SELECT sqlj.set_classpath('javatest', 'examples');
 set_classpath 
---------------
 
(1 row)

-- 1.6 revokes USAGE on the trusted language from PUBLIC; the tests run as
-- pljava_test, so grant it back explicitly.
GRANT USAGE ON LANGUAGE java TO pljava_test;
-- pljava.control says schema = sqlj, so CREATE EXTENSION pre-creates the schema
-- and PL/Java's own groundwork leaves its permissions untouched: public has no
-- USAGE on sqlj, which the class loader needs when a non-superuser calls in.
GRANT USAGE ON SCHEMA sqlj TO public;
alter database pljava_test owner to pljava_test;
\c pljava_test pljava_test
