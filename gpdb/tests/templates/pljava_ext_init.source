CREATE EXTENSION pljava;

-- PL/Java 1.6 loads classes from the sqlj jar repository, which WarehousePG
-- replicates to every segment. Install the examples jar (no deploy: the test
-- creates its own functions) and give the javatest schema a classpath to it.
SELECT sqlj.install_jar('file:@EXAMPLES_JAR@', 'examples', false);
CREATE SCHEMA javatest AUTHORIZATION pljava_test;
SELECT sqlj.set_classpath('javatest', 'examples');

alter database pljava_test owner to pljava_test;

\c pljava_test pljava_test
